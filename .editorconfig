root = true

[*.cs]

# Стиль namespace: file-scoped (с точкой с запятой)
csharp_style_namespace_declarations = file_scoped:warning

# Предпочитать явные модификаторы доступа
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:warning

# Выражения body для методов (по желанию)
csharp_style_expression_bodied_methods = when_on_single_line:warning

# Для дженериков пробелы не настраиваются отдельно — всегда без пробелов
csharp_style_space_after_typecast = false
csharp_space_around_binary_operators = before_and_after

[*.{cs,vb,csproj,sln}]
charset = utf-8